-- Create a view for employees earning more than 50,000
mysql> create view highest_salary as
    ->  select *
    -> from
    -> employee
    -> where
    -> salary > 50000;
Query OK, 0 rows affected (0.01 sec)

mysql> select * from highest_salary
    -> ;
