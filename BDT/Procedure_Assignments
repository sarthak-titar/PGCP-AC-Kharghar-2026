-- Q7:Create a stored procedure calculate_electricity_bill that accepts consumer name and units consumed.
--  Calculate the electricity bill using the slab-wise rates below. 
-- Display consumer name, units consumed, and total bill amount. 

mysql> DELIMITER //
mysql>
mysql> CREATE PROCEDURE calculate_electricity_bill(
    ->     IN name VARCHAR(100),
    ->     IN unit INT
    -> )
    -> BEGIN
    ->
    ->     IF unit <= 100 THEN
    ->
    ->         SELECT name, unit, (unit * 2) AS total_bill;
    ->
    ->     ELSEIF unit <= 200 THEN
    ->
    ->         SELECT name, unit,
    ->                (100 * 2) + ((unit - 100) * 3) AS total_bill;
    ->
    ->     ELSEIF unit <= 400 THEN
    ->
    ->         SELECT name, unit,
    ->                (100 * 2) + (100 * 3) + ((unit - 200) * 5) AS total_bill;
    ->
    ->     ELSE
    ->
    ->         SELECT name, unit,
    ->                (100 * 2) + (100 * 3) + (200 * 5)
    ->                + ((unit - 400) * 7) AS total_bill;
    ->
    ->     END IF;
    ->
    -> END //
